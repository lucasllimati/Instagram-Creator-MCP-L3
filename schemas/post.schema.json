{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "perfil", "data", "pilar", "formato", "titulo", "tema_slug", "slides", "status", "fontes"],
  "properties": {
    "id": { "type": "string", "pattern": "^(FIN|MKT)-\\d{4}-\\d{2}-\\d{2}(-evento)?$" },
    "perfil": { "enum": ["FIN", "MKT"] },
    "data": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pilar": { "enum": ["conceito", "erro", "exemplo", "livro", "checklist", "comparativo", "reflexao", "atualidade", "evento"] },
    "formato": { "enum": ["carrossel", "post_unico"] },
    "prioridade": { "enum": ["normal", "evento"] },
    "titulo": { "type": "string", "minLength": 1 },
    "tema_slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "enum": ["roteiro", "validado", "revisado", "renderizado", "pronto", "revisar_humano"] },
    "hipotetico": { "type": "boolean" },
    "valido_ate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "enquete_manual": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "tipo", "titulo"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "tipo": { "enum": ["capa", "conteudo", "cta", "frase", "grafico"] },
          "titulo": { "type": "string", "minLength": 1 },
          "texto": { "type": "string" },
          "itens": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "cta": { "type": "string" },
          "serie": { "type": "integer" }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "texto"],
        "properties": {
          "tipo": { "enum": ["chamada", "curiosidade", "salve"] },
          "texto": { "type": "string", "minLength": 1 }
        }
      }
    },
    "narracao": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "legenda": { "type": "string" },
    "hashtags": { "type": "array", "items": { "type": "string" } },
    "alt_text": { "type": "array", "items": { "type": "string" } },
    "citacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texto", "autor", "obra"],
      "properties": {
        "texto": { "type": "string" },
        "autor": { "type": "string", "minLength": 1 },
        "obra": { "type": "string", "minLength": 1 }
      }
    },
    "livro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "autor"],
      "properties": {
        "titulo": { "type": "string", "minLength": 1 },
        "autor": { "type": "string", "minLength": 1 }
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["descricao", "url", "data"],
        "properties": {
          "descricao": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "veiculo": { "type": "string" },
          "primaria": { "type": "boolean" }
        }
      }
    },
    "dados_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serie", "inicio", "fim", "coletado_em", "valores_declarados"],
      "properties": {
        "serie": { "type": "integer" },
        "inicio": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fim": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "coletado_em": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "valores_declarados": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data", "valor"],
            "properties": {
              "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "valor": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
